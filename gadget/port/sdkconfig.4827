# Sunton/Guition ESP32-4827S043: ESP32-S3-WROOM-1 N16R8 (16 MB quad flash, 8 MB OCTAL PSRAM),
# 4.3" 480x272 colour RGB-parallel IPS (ST7262), GT911 capacitive touch, microSD, CH340 USB-serial
# (easy flashing). Load last, after sdkconfig.defaults.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_HOMEHUB_LED_BACKEND_4827S043_RGB=y
CONFIG_HOMEHUB_BUTTON_GPIO=0

# 16 MB quad flash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 8 MB OCTAL PSRAM (holds the 480x272x2 = 255 KB RGB frame buffer + the Muse session).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Applet runtime (touch launcher once GT911 lands).
CONFIG_HOMEHUB_MUSECORDER=y

# BLE HID (stage 1): keep Bluetooth up after pairing so an HID keyboard profile can run.
# Allowed because MUSE_ENABLED is off (we pair via HomeHub, not the on-device Muse-voice feature).
CONFIG_HOMEHUB_BLE_PERSISTENT=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_HOMEHUB_BLE_PERSISTENT_ADV_INTERVAL_MS=1000
