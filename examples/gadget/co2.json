{"id":"co2","name":"CO2 Meter","i2c":{"sda":32,"scl":25},
 "state":{"co2":0,"t":0,"h":0},
 "screen":[{"big":"${co2}"},{"text":"ppm CO2"},{"bar":"${co2}","max":2000},{"text":"Temp ${t} F"},{"text":"Humidity ${h}%"}],
 "on":{"start":[{"i2c.write":{"addr":98,"cmd":[63,134],"wait":500}},{"i2c.write":{"addr":98,"cmd":[33,177]}}],
       "every:5":[{"i2c.read":{"addr":98,"cmd":[236,5],"wait":5,"len":9,"to":"m"}},
                  {"if":"${m.0*256+m.1>0}","then":[
                     {"set":{"co2":"${m.0*256+m.1}","t":"${round((-45+175*(m.3*256+m.4)/65535)*9/5+32)}","h":"${round(100*(m.6*256+m.7)/65535)}"}},
                     {"if":"${co2>1500}","then":[{"led":"#ff0000"}],"else":[{"led":"#00ff00"}]}]}],
       "every:300":[{"muse.say":"CO2 ${co2} ppm, ${t} F, ${h}% RH"}]}}
